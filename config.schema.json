{
  "pluginAlias": "AdvantageAir",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "required": ["name", "devices"],
    "additionalProperties": false,
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Homebridge Advantage Air"
      },
      "devices": {
        "title": "Controllers",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["ipAddress"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "title": "Controller name",
              "type": "string",
              "default": "Aircon"
            },
            "ipAddress": {
              "title": "IP address",
              "description": "The wall-mounted controller's IP address. A reserved address in your router is recommended.",
              "type": "string",
              "format": "ipv4"
            },
            "port": {
              "title": "Port",
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "default": 2025
            },
            "debug": {
              "title": "Detailed debug logging",
              "description": "Log controller read summaries without including full responses.",
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    }
  }
}